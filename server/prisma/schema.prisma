// ============================================================
// Educational Platform - Prisma Schema
// PostgreSQL Database
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum Role {
  STUDENT
  ADMIN
}

enum ContentStatus {
  ACTIVE
  INACTIVE
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ------------------------------------------------------------
// USERS
// ------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  role         Role     @default(STUDENT)

  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  status       ContentStatus @default(ACTIVE)

  progress     Progress[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([teamId])
  @@map("users")
}

// ------------------------------------------------------------
// TEAMS (الفرق الدراسية)
// ------------------------------------------------------------

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  order       Int      @default(0)
  status      ContentStatus @default(ACTIVE)

  users       User[]
  subjects    Subject[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("teams")
}

// ------------------------------------------------------------
// SUBJECTS (المواد الدراسية)
// ------------------------------------------------------------

model Subject {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  name        String
  description String?
  imageUrl    String?
  order       Int      @default(0)
  status      ContentStatus @default(ACTIVE)

  lectures    Lecture[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([teamId])
  @@map("subjects")
}

// ------------------------------------------------------------
// LECTURES (المحاضرات)
// ------------------------------------------------------------

model Lecture {
  id           String   @id @default(uuid())
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  title        String
  description  String?

  pdfUrl       String?
  audioUrl     String?
  thumbnailUrl String?

  order        Int      @default(0)
  status       ContentStatus @default(ACTIVE)

  progress     Progress[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([subjectId])
  @@map("lectures")
}

// ------------------------------------------------------------
// PROGRESS (متابعة تقدم الطالب)
// ------------------------------------------------------------

model Progress {
  id               String         @id @default(uuid())

  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  lectureId        String
  lecture          Lecture        @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  status           ProgressStatus @default(NOT_STARTED)
  progressPercent  Int            @default(0)
  audioProgress    Int            @default(0) // seconds

  pdfViewed        Boolean        @default(false)
  audioPlayed      Boolean        @default(false)

  completedAt      DateTime?
  lastAccessedAt   DateTime       @default(now())

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([userId, lectureId])
  @@index([userId])
  @@index([lectureId])
  @@map("progress")
}

// ------------------------------------------------------------
// BANNERS
// ------------------------------------------------------------

model Banner {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String
  buttonText  String?
  link        String?
  order       Int      @default(0)
  status      ContentStatus @default(ACTIVE)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("banners")
}
